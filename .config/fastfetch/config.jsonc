{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/Pictures/cuddlyferris.png",
    "height": 9,
    "padding": {
      "top": 1
    }
  },
  "display": {
    "separator": " > "
  },
  "modules": [
    "break",
    "title",
    "break",
    {
      "type": "os",
      "key": "OS      "
    },
    {
      "key": "CPU     ",
      "type": "cpu"
    },
    {
      "key": "GPU     ",
      "type": "gpu"
    },
    {
      "key": "memory  ",
      "type": "memory"
    },
    {
      "key": "local IP",
      "type": "localip"
    },
    {
      "key": "terminal",
      "type": "terminal"
    },
    {
      "key": "shell   ",
      "type": "shell"
    }
  ]
}
