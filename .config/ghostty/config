font-family = Paper Mono
font-size = 16
font-thicken = true
adjust-cell-height = 12

window-padding-x = 12
window-padding-y = 12

maximize = true
theme = light:Adwaita,dark:Ghostty Dark Custom
# theme = Ghostty Dark Custom

macos-titlebar-style = native
background-blur = 128
background-opacity = 0.90

keybind = super+j=jump_to_prompt:1
keybind = super+k=jump_to_prompt:-1

command = /bin/zsh -lc 'exec fish'

auto-update = download
